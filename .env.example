# Set these in your process environment; the server does not read .env files.
ADDR=127.0.0.1:8080
DATABASE_DSN=delegao:change-me@tcp(127.0.0.1:3306)/delegao
# Generated public HTML; writable by the single Go process, outside the repo in production.
PUBLIC_DIR=./public
BUILD_WORKERS=2
DB_MAX_OPEN_CONNS=4
DB_MAX_IDLE_CONNS=1
# Must be true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=true
# Set only when these networks are your own reverse proxies.
TRUSTED_PROXIES=
GUESTBOOK_ANSWER=Ravioli
# Go runtime starting values for a 512 MB board; these are not measured RSS limits.
GOMEMLIMIT=64MiB
GOMAXPROCS=2
