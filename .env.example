# Set these in your process environment; the server does not read .env files.
ADDR=127.0.0.1:8080
DATABASE_DSN=delegao:change-me@tcp(127.0.0.1:3306)/delegao
# Must be true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=true
# Set only when these networks are your own reverse proxies.
TRUSTED_PROXIES=
GUESTBOOK_ANSWER=Ravioli
