# Install as /etc/delegao.env, owned by root:delegao with mode 0640.
# This syntax works for both systemd EnvironmentFile and POSIX shell sourcing.
# Port 8080 is already used by another site on the existing Orange Pi.
ADDR=127.0.0.1:18080
DATABASE_DRIVER=sqlite
DATABASE_DSN=/var/lib/delegao/site.db
PUBLIC_DIR=/var/lib/delegao/public
BUILD_WORKERS=2
DB_MAX_OPEN_CONNS=4
DB_MAX_IDLE_CONNS=1
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1/32
# Optional login rate-limit exemptions; password and CSRF remain required.
# LOGIN_RATE_LIMIT_WHITELIST=198.51.100.10,2001:db8::10
GUESTBOOK_ANSWER=Ravioli
GOMEMLIMIT=64MiB
GOMAXPROCS=2
